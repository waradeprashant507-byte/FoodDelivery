# Copy this file to .env, then restart `npm run dev` (Vite reads .env only at startup)

# false = talk to your Spring Boot API (data goes to MySQL)
# true  = built-in demo data, nothing is saved to the database
VITE_USE_MOCK=false
VITE_API_URL=http://localhost:8080/api
VITE_CURRENCY=INR

# Google Maps JavaScript API key (enable: Maps JavaScript API + Geocoding API)
VITE_GOOGLE_MAPS_KEY=AIzaSyAF55NxrLZAJ3n3C15curuX9RK8T4vFoxU
# Optional: your own Map ID from Google Cloud (needed for custom map styling)
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# Fallbacks only. Each restaurant's own location comes from the backend.
VITE_RESTAURANT_NAME=Crave
VITE_RESTAURANT_LAT=19.0760
VITE_RESTAURANT_LNG=72.8777
